---
// Subtle diagonal "speed slash" accent with a halftone dot fade at the
// tip — a nod to sports/motion, kept intentionally faint so it reads as
// texture rather than a graphic. Meant to sit in one corner of a section,
// never full-bleed. Sized via the wrapping element's width/height.

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class={`pointer-events-none ${className}`}
  viewBox="0 0 400 260"
  preserveAspectRatio="xMaxYMin slice"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="speedSlash" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#c98456" stop-opacity="0" />
      <stop offset="100%" stop-color="#c98456" stop-opacity="0.22" />
    </linearGradient>
  </defs>
  <g>
    <polygon points="260,0 400,0 300,100 220,100" fill="url(#speedSlash)" />
    <polygon points="300,40 400,40 340,120 280,120" fill="url(#speedSlash)" />
  </g>
  <g fill="#e0a97d" opacity="0.25">
    <circle cx="215" cy="98" r="1.4" /><circle cx="225" cy="94" r="1.4" /><circle cx="235" cy="90" r="1.4" />
    <circle cx="245" cy="86" r="1.4" /><circle cx="255" cy="82" r="1.4" />
    <circle cx="220" cy="106" r="1.2" /><circle cx="230" cy="102" r="1.2" /><circle cx="240" cy="98" r="1.2" />
  </g>
</svg>

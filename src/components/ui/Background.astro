---
// Sitewide ambient background: a static field of dots in the site's
// accent colors, plus a soft glow that follows the cursor. The dots used
// to drift continuously — removed per the move toward a muted, calm feel;
// a moving field read as more "alive/techy" than the site wants now.
// Cursor glow stays since it's user-driven, not an ambient animation.
---

<div class="site-background" aria-hidden="true">
  <canvas id="bg-particles"></canvas>
  <div id="bg-glow" class="bg-glow"></div>
</div>

<style>
  .site-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  #bg-particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bg-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(201, 132, 86, 0.16) 0%,
      rgba(224, 169, 125, 0.08) 45%,
      transparent 72%
    );
    mix-blend-mode: screen;
    opacity: 0;
    transform: translate3d(-9999px, -9999px, 0);
    transition: opacity 0.5s ease;
    will-change: transform;
  }

  .bg-glow.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-glow {
      display: none;
    }
  }
</style>

<script>
  type Particle = {
    x: number;
    y: number;
    r: number;
    alpha: number;
    hue: 'blue' | 'blueLight';
  };

  const PARTICLE_COLORS = {
    blue: '201, 132, 86',
    blueLight: '224, 169, 125',
  } as const;

  const canvas = document.getElementById('bg-particles') as HTMLCanvasElement | null;
  const glow = document.getElementById('bg-glow');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function setupParticles(canvasEl: HTMLCanvasElement) {
    const ctx = canvasEl.getContext('2d');
    if (!ctx) return;

    let width = window.innerWidth;
    let height = window.innerHeight;
    let particles: Particle[] = [];

    function makeParticles() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvasEl.width = width * dpr;
      canvasEl.height = height * dpr;
      canvasEl.style.width = `${width}px`;
      canvasEl.style.height = `${height}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(60, Math.round((width * height) / 26000));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 1.3 + 0.5,
        alpha: Math.random() * 0.3 + 0.1,
        hue: Math.random() < 0.7 ? 'blue' : 'blueLight',
      }));
    }

    function draw() {
      ctx!.clearRect(0, 0, width, height);
      for (const p of particles) {
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${PARTICLE_COLORS[p.hue]}, ${p.alpha})`;
        ctx!.fill();
      }
    }

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      makeParticles();
      draw();
    }

    resize();
    window.addEventListener('resize', resize);
  }

  function setupCursorGlow(glowEl: HTMLElement) {
    let targetX = -9999;
    let targetY = -9999;
    let x = -9999;
    let y = -9999;
    const half = 160;
    let rafId: number | null = null;

    function frame() {
      x += (targetX - x) * 0.12;
      y += (targetY - y) * 0.12;
      glowEl.style.transform = `translate3d(${x - half}px, ${y - half}px, 0)`;
      rafId = requestAnimationFrame(frame);
    }

    window.addEventListener('pointermove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;
      glowEl.classList.add('is-visible');
    });

    window.addEventListener('pointerleave', () => {
      glowEl.classList.remove('is-visible');
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      } else if (!document.hidden && rafId === null) {
        rafId = requestAnimationFrame(frame);
      }
    });

    rafId = requestAnimationFrame(frame);
  }

  if (canvas) {
    setupParticles(canvas);
  }

  if (glow && !reduceMotion) {
    setupCursorGlow(glow);
  }
</script>

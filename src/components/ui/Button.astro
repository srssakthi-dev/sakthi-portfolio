---
// Shared button — every "View resume" / "Get in touch" / etc. link on the
// site renders through here, so the look lives in one place (global.css's
// .btn-primary / .btn-secondary) instead of being copy-pasted per page.
// Change the button system once, and every page picks it up.
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'secondary', class: className = '' } = Astro.props;
const variantClass = variant === 'primary' ? 'btn-primary' : 'btn-secondary';
---

<a href={href} class={`${variantClass} ${className}`.trim()}>
  <slot />
</a>

---
// Shared About content — used both as a section embedded on the home
// page (#about, reached from the nav) and standalone at /about. One
// source of content, two places it can render.

const pills = ['Guitar', 'Chess', 'Baking', 'Coffee & Tea', 'Football'];

const involvement = [
  {
    title: 'Basketball Team Captain — Bedok View Secondary School',
    period: 'Jan 2019 – Dec 2020',
    desc: 'Captained the school team through competitions, communicating under pressure, supporting teammates with different strengths, and leading with accountability. Those lessons still shape how I approach teamwork today.',
  },
  {
    title: 'Volunteer — Team Nila, Youth Corps Singapore, Singapore Computer Society',
    period: '2021 – Present',
    desc: 'Digital assistance for elderly users, sports and food distribution, and environmental activities, working alongside people from diverse backgrounds.',
  },
  {
    title: 'Data Analytics Club — Singapore Institute of Management',
    period: 'Sep 2025 – Mar 2026',
    desc: 'Worked on internal data science projects with peers, strengthening interest in AI and applied analytics.',
  },
  {
    title: 'SIM-UOL CS Student Council Hackathon',
    period: 'Nov 2024',
    desc: 'Collaborated in a 5-member team to design and build a browser-based scrolling game in a 2-day hackathon.',
  },
];
---

<div class="relative max-w-3xl mx-auto">
  <span class="kicker">About</span>
  <h2 class="page-heading mt-3">The person behind the code</h2>

  <p class="mt-6 max-w-2xl lead">
    Hi! I'm Sakthi, a final-year Computer Science student at the Singapore Institute of Management, pursuing
    the University of London BSc (Hons) in Computer Science.
  </p>

  <div class="mt-10 max-w-xl border-l-2 border-white/10 pl-5">
    <p class="font-semibold text-white/90">Singapore Institute of Management – University of London</p>
    <p class="mt-1 text-sm text-white/50">BSc (Honours) in Computer Science · Expected Sep 2026</p>
    <p class="mt-3 text-sm body-text">
      Coursework: AI &amp; ML, OOP, Algorithms &amp; Data Structures, Computer Security, NLP, Data Science,
      Discrete &amp; Computational Mathematics, Software Design &amp; Development
    </p>
  </div>

  <div class="mt-14 max-w-2xl">
    <h3 class="kicker">What drives me</h3>
    <p class="mt-4 body-text">
      I'm fascinated by how artificial intelligence, machine learning, and data can solve meaningful,
      real-world problems, and just as driven by the software engineering that brings those ideas to life.
      I enjoy exploring data and building practical solutions, motivated by understanding not just what works,
      but why.
    </p>
    <p class="mt-4 body-text">
      I also enjoy teaching and mentoring, whether working with young people, collaborating with teammates, or
      sharing something I've learned. Breaking down complex ideas into concepts others can grasp with
      confidence is genuinely rewarding to me.
    </p>
  </div>

  <div class="mt-14">
    <h3 class="kicker">Outside of tech</h3>
    <div class="mt-4 flex flex-wrap gap-2">
      {pills.map((pill) => (
        <span class="text-sm px-4 py-1.5 rounded-full border border-white/15 text-white/70">{pill}</span>
      ))}
    </div>
  </div>

  <div class="mt-14">
    <h3 class="kicker">Leadership &amp; involvement</h3>
    <div class="mt-5 space-y-6">
      {involvement.map((item) => (
        <div class="border-l-2 border-white/10 pl-4">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-semibold text-white/90">{item.title}</span>
            <span class="meta-text">{item.period}</span>
          </div>
          <p class="mt-1 text-sm body-text">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>

  <p class="mt-14 max-w-2xl body-text">
    I'm excited by opportunities in artificial intelligence, machine learning, and data, alongside
    strengthening my software engineering foundations. Above all, I'm motivated by solving meaningful
    problems and the chance to keep learning.
  </p>

  <div class="mt-16 flex flex-wrap gap-4">
    <a
      href="/resume.pdf"
      class="px-5 py-2.5 rounded-lg bg-accent text-white text-sm font-semibold hover:bg-accent-dark transition-colors"
    >
      Resume
    </a>
    <a
      href="/contact"
      class="px-5 py-2.5 rounded-lg border border-white/15 text-white/70 text-sm font-medium hover:border-accent-light hover:text-accent-light transition-colors"
    >
      Get in touch
    </a>
  </div>
</div>

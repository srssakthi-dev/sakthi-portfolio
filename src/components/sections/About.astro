---
import Button from '../ui/Button.astro';

// About page content, rendered standalone at /about (not embedded
// anywhere else — the home page's Hero links out to it instead).
//
// Redesigned from a tabbed card into a flat grid of category cards
// (Education, Experience, Hackathons, Leadership, Activities,
// Volunteering) — content pulled directly from the resume so dates and
// wording stay accurate instead of paraphrased.

const education = [
  {
    title: 'Singapore Institute of Management',
    subtitle: 'University of London · BSc (Hons) Computer Science',
    period: 'Expected Sep 2026',
    location: 'Singapore',
    bullets: [
      'Coursework: AI & ML, OOP, Algorithms & Data Structures, Computer Security, NLP, Data Science, Discrete & Computational Mathematics, Software Design & Development.',
    ],
  },
  {
    title: 'Jurong Pioneer Junior College',
    subtitle: 'GCE A-Level',
    period: '2021 – 2022',
    location: 'Singapore',
  },
];

const experience = [
  {
    title: 'Associate Trainer',
    subtitle: 'HA Academy (Flexible/Ad hoc)',
    period: 'Oct 2024 – Present',
    location: 'Singapore',
    bullets: [
      'Facilitated workshops for 100+ students across schools, developing communication and presentation skills.',
      'Mentored students during camps, demonstrating adaptability and leadership in fast-paced environments.',
    ],
  },
];

const hackathons = [
  {
    title: 'Microsoft Azure AI Hackathon · SIM IT Club HackXperience 2026',
    period: 'Jul 2026',
    bullets: [
      'Collaborated on an AI-powered project coordination system using Microsoft Azure AI Foundry and multi-agent workflows.',
      'Integrated RAG with Azure AI Search and contributed to backend development.',
    ],
  },
  {
    title: 'SIM-UOL CS Student Council Hackathon',
    period: 'Nov 2024',
    bullets: [
      'Developed a browser-based fitness game with a 5-member team, promoting physical activity through gamification.',
    ],
  },
];

const leadership = [
  {
    title: 'Basketball Team Captain',
    subtitle: 'Bedok View Secondary School',
    period: 'Jan 2019 – Dec 2020',
    bullets: [
      'Led the school basketball team during competitions, coordinating training, teamwork, and on-court communication.',
    ],
  },
];

const activities = [
  {
    title: 'Data Analytics Club',
    subtitle: 'Singapore Institute of Management',
    period: 'Sep 2025 – Mar 2026',
    bullets: [
      'Worked on internal data science projects with peers, improving understanding of data analysis concepts and strengthening interest in AI and applied analytics.',
    ],
  },
];

const volunteering = [
  {
    title: 'Team Nila',
    subtitle: 'Sports & Community Volunteering',
    bullets: [
      'Engaged in sports programmes and food distribution efforts for underprivileged communities.',
    ],
  },
  {
    title: 'Youth Corps Singapore',
    subtitle: 'Community & Environmental Volunteering',
    bullets: [
      'Contributed to environmental activities and community workshops supporting local communities.',
    ],
  },
  {
    title: 'Singapore Computer Society (SCS)',
    subtitle: 'Digital Support & Community Outreach',
    bullets: [
      'Supported digital assistance activities helping elderly users navigate technology and services (e.g. SimplyGo).',
    ],
  },
];

const leadershipActivities = [...leadership, ...activities];

const cards = [
  { label: 'Education', entries: education, wide: true },
  { label: 'Experience', entries: experience },
  { label: 'Hackathons', entries: hackathons },
  { label: 'Leadership & Activities', entries: leadershipActivities },
  { label: 'Volunteer Activities', entries: volunteering, period: '2021 – Present' },
];
---

<div class="relative max-w-5xl mx-auto">
  <h1 class="page-heading max-w-3xl mx-auto">About</h1>

  <div class="mt-4 max-w-3xl mx-auto">
    <p class="body-text">
      I'm a Computer Science undergraduate interested in using AI, data and software development to
      create solutions that have a meaningful purpose in the real world.
    </p>
    <p class="mt-3 body-text">
      I enjoy working with real-world data, building and training machine learning models, and
      developing AI-powered systems to solve practical problems. I'm naturally curious and like to
      understand what I'm working with in depth, learning through both exploration and building. I also
      enjoy sharing what I learn through teaching and mentoring others.
    </p>
  </div>

  <div class="mt-10 max-w-3xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-5">
    {cards.map((card) => (
      <div class={`group surface-card p-5 sm:p-6 ${card.wide ? 'sm:col-span-2' : ''}`}>
        <div class="flex items-baseline justify-between gap-3">
          <p class="font-display font-semibold text-accent-light">{card.label}</p>
          {card.period && <span class="text-xs text-ink/40 flex-shrink-0">{card.period}</span>}
        </div>

        <div class="mt-4 space-y-8">
          {card.entries.map((entry) => (
            <div class="relative pl-5 border-l-2 border-ink/10">
              <span class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-accent transition-colors group-hover:bg-accent-light"></span>
              <p class="text-sm font-semibold text-ink/90">{entry.title}</p>
              {entry.subtitle && <p class="mt-0.5 text-sm text-ink/50">{entry.subtitle}</p>}

              {(entry.period || entry.location) && (
                <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink/45">
                  {entry.period && (
                    <span class="flex items-center gap-1">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                      </svg>
                      {entry.period}
                    </span>
                  )}
                  {entry.location && (
                    <span class="flex items-center gap-1">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                        <circle cx="12" cy="10" r="3" />
                      </svg>
                      {entry.location}
                    </span>
                  )}
                </div>
              )}

              {entry.bullets && (
                <ul class="mt-3 space-y-2.5">
                  {entry.bullets.map((b) => (
                    <li class="flex gap-3 text-sm text-ink/75 leading-relaxed">
                      <span class="text-accent">›</span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-10 max-w-3xl mx-auto surface-card p-5 sm:p-6">
    <p class="font-display font-semibold text-accent-light">If you've made it this far, haha</p>
    <p class="mt-4 text-sm text-ink/75 leading-relaxed">
      I play basketball, guitar, and bake for friends when I get the chance. I love getting lost in a
      good book, plotting my next move over a game of chess, and sipping a good cup of coffee through it
      all.
    </p>
  </div>

  <div class="mt-10 max-w-3xl mx-auto flex flex-wrap gap-4">
    <Button href="/projects" variant="primary">View my work</Button>
    <Button href="/contact" variant="secondary">Get in touch</Button>
  </div>
</div>

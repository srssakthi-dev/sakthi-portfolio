---
import Button from '../ui/Button.astro';

const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/srssakthi-dev',
    icon: 'M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.19 1.78 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z',
    filled: true,
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/sakthi-m-686b243a9/',
    icon: 'M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z',
    filled: true,
  },
  {
    label: 'Email',
    href: 'mailto:srssakthi7@gmail.com',
    icon: 'M3 6l9 6 9-6M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z',
    filled: false,
  },
];

// Underlined text links replacing the old tilted fan-cards. Each carries
// its own hover tone (mapped loosely to the cool accent family) so the
// row still reads as distinct destinations without the weight of boxed
// buttons — per-page color coding kept to just this link row, not
// carried into the pages themselves.
const pageLinks = [
  { label: 'Projects', href: '/projects' },
  { label: 'About me', href: '/about' },
  { label: 'Skills', href: '/skills' },
  { label: 'Get in touch', href: '/contact' },
];
---

<section id="home" class="hero relative px-6 sm:px-10 pt-10 sm:pt-14 lg:pt-6 pb-12 lg:pb-8 overflow-hidden">
  <div class="relative max-w-3xl w-full mx-auto text-center">
    <p class="kicker justify-center flex">AI/ML &middot; Data &middot; Software</p>

    <h1 class="warm-heading font-display text-6xl sm:text-7xl font-semibold leading-[1.05] mt-4 lg:mt-2">
      <span class="block">Hey, I&rsquo;m</span>
      <span class="block"><span id="typedTarget"></span><span class="hero-cursor" aria-hidden="true"></span></span>
    </h1>

    <p class="mt-5 lg:mt-3 text-lg body-text leading-relaxed max-w-md mx-auto">
      Computer Science student exploring AI, machine learning, and data through hands-on software
      development. Currently seeking internship opportunities across AI/ML, Data, and Software.
    </p>

    <div class="mt-8 lg:mt-6 flex items-center gap-5 justify-center">
      {socials.map((social) => (
        <a
          href={social.href}
          aria-label={social.label}
          class="text-ink-muted hover:text-accent-dark transition-colors"
        >
          <svg
            viewBox="0 0 24 24"
            width="34"
            height="34"
            fill={social.filled ? 'currentColor' : 'none'}
            stroke={social.filled ? 'none' : 'currentColor'}
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d={social.icon} />
          </svg>
        </a>
      ))}
    </div>

    <div class="mt-8 lg:mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      {pageLinks.map((link) => (
        <a href={link.href} class="hero-link">{link.label}</a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Blinking cursor after the typed name, sharing the same visual
     language as the terminal/CLI-flavoured projects elsewhere on the
     site (crypto CLI simulator, terminal icon in the projects grid). */
  .hero-cursor {
    display: inline-block;
    width: 3px;
    height: 0.85em;
    background: var(--color-accent-dark);
    margin-left: 4px;
    vertical-align: -0.05em;
    animation: hero-blink 0.9s steps(1) infinite;
  }

  @keyframes hero-blink {
    50% { opacity: 0; }
  }

  .hero-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-decoration-color: rgba(72, 64, 55, 0.18);
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  /* One shared accent hover for all four links — replaces the earlier
     per-link tone idea (plum/teal/orange), which no longer fit once the
     rest of the site settled on a single blue accent everywhere. */
  .hero-link:hover {
    color: var(--color-accent-dark);
    text-decoration-color: var(--color-accent-dark);
  }
</style>

<script>
  const target = 'Sakthi';
  const el = document.getElementById('typedTarget');
  let i = 0;
  function type() {
    if (el && i <= target.length) {
      el.textContent = target.slice(0, i);
      i++;
      setTimeout(type, 130);
    }
  }
  type();
</script>

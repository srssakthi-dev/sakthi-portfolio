// Personal highlight cards — tilted-photo-card frame, carrying a status/fact
// about Sakthi instead of a project screenshot. Each card links out to the
// page it's referencing (About, Projects, email).
const cards = [
  {
    label: 'Studying',
    title: 'SIM – University of London',
    subtitle: 'BSc Computer Science',
    href: '/about',
    linkText: 'View about',
    icon: '<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1.5 2.5 3 6 3s6-1.5 6-3v-5"/>',
    pos: { top: '0%', left: '0%', rot: '-7deg', z: 2 },
  },
  {
    label: 'Building now',
    title: 'Multimodal RAG system',
    subtitle: 'Final year project',
    href: '/projects',
    linkText: 'View projects',
    icon: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
    pos: { top: '0%', left: '56%', rot: '5deg', z: 2 },
  },
  {
    label: 'Open to',
    title: 'AI/ML · Data · Software Engineering',
    subtitle: 'Internship opportunities',
    href: 'mailto:srssakthi7@gmail.com',
    linkText: 'Email me',
    icon: '<path d="M3 6l9 6 9-6M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/>',
    pos: { top: '38%', left: '20%', rot: '-2deg', z: 1 },
  },

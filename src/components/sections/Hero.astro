---
import { projects } from '../../data/projects';

const featured = projects[0];

const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/srssakthi-dev',
    icon: 'M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.19 1.78 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/your-profile',
    icon: 'M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z',
  },
];

const belt = ['Python', 'AI / ML', 'Backend', 'PyTorch', 'Node.js', 'SQL'];
---

<section id="home" class="hero relative px-6 sm:px-10 py-16 min-h-dvh flex flex-col justify-center">
  <div class="relative max-w-4xl w-full mx-auto text-center">
    <h1 class="warm-heading font-display text-5xl sm:text-6xl font-bold leading-[1.05]">
      Hi, I'm <span class="name-outline">Sakthi</span>
    </h1>

    <p class="mt-5 text-lg text-white/60 leading-relaxed max-w-md mx-auto">
      Computer Science student building intelligent systems with AI, machine learning, and data.
    </p>

    <div class="belt-wrap mt-8">
      <div class="belt-track">
        {[...belt, ...belt].map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </div>

    <a href={`/projects#${featured.slug}`} class="featured-card mt-10 block max-w-md mx-auto text-left">
      <span class="kicker">Latest project</span>
      <p class="mt-2 font-display font-semibold text-lg text-white/90">{featured.title}</p>
      <p class="mt-2 text-sm text-white/55 leading-relaxed">{featured.summary}</p>
      <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-light">
        See all projects
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
      </span>
    </a>

    <div class="mt-7 flex items-center justify-center gap-5">
      {socials.map((social) => (
        <a
          href={social.href}
          aria-label={social.label}
          class="text-white/50 hover:text-accent-light transition-colors"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d={social.icon} />
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .featured-card {
    padding: 20px 22px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .featured-card:hover {
    transform: translateY(-3px);
    border-color: rgba(201, 132, 86, 0.35);
  }

  .belt-wrap {
    position: relative;
    overflow: hidden;
    padding: 14px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .belt-track {
    display: flex;
    width: max-content;
    gap: 2.5rem;
    animation: belt-move 18s linear infinite;
  }

  .belt-track span {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: rgba(224, 169, 125, 0.75);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .belt-track span::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
  }

  @keyframes belt-move {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .belt-track {
      animation: none;
    }
  }
</style>

---
import CodeWindow from '../ui/CodeWindow.astro';

const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/srssakthi-dev',
    icon: 'M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.19 1.78 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/your-profile',
    icon: 'M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z',
  },
];

const pills = ['Python', 'AI / ML', 'Backend'];

const sections = [
  {
    label: 'About',
    href: '/about',
    filename: 'about.ts',
    command: 'cd ./about',
    tagline: 'the person behind the code',
    icon: '<circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/>',
  },
  {
    label: 'Projects',
    href: '/projects',
    filename: 'projects.ts',
    command: 'cd ./projects',
    tagline: 'some things I’ve built',
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  },
  {
    label: 'Experience',
    href: '/experience',
    filename: 'experience.ts',
    command: 'cd ./experience',
    tagline: 'where I’ve worked',
    icon: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>',
  },
  {
    label: 'Contact',
    href: '/contact',
    filename: 'contact.ts',
    command: 'cd ./contact',
    tagline: 'let’s talk',
    icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>',
  },
];
---

<section id="home" class="hero relative px-6 pt-20 pb-16 overflow-hidden">
  <div class="hero-grid pointer-events-none absolute inset-0"></div>
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute top-[-15%] left-[10%] w-[500px] h-[500px] rounded-full bg-accent/20 blur-[130px]"></div>
    <div class="absolute top-[30%] right-[8%] w-[420px] h-[420px] rounded-full bg-accent-purple/15 blur-[130px]"></div>
    <div class="absolute bottom-[-10%] left-[20%] w-[460px] h-[460px] rounded-full bg-accent/10 blur-[140px]"></div>
  </div>

  <div class="relative max-w-3xl mx-auto text-center">
    <h1 class="warm-heading font-display text-5xl sm:text-6xl font-medium leading-[1.05]">
      Hi, I'm Sakthi
    </h1>

    <p class="mt-5 text-lg text-white/60 leading-relaxed max-w-md mx-auto">
      Computer Science student building intelligent systems with AI, machine learning, and data.
    </p>

    <div class="mt-6 flex flex-wrap justify-center gap-2">
      {pills.map((pill) => (
        <span class="text-sm px-4 py-1.5 rounded-full border border-white/15 text-white/70">{pill}</span>
      ))}
    </div>

    <div class="mt-7 flex items-center justify-center gap-5">
      {socials.map((social) => (
        <a
          href={social.href}
          aria-label={social.label}
          class="text-white/50 hover:text-accent-light transition-colors"
        >
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path d={social.icon} />
          </svg>
        </a>
      ))}
    </div>

    <div class="relative mt-12 max-w-3xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-5 text-left">
      {sections.map((s) => (
        <a href={s.href} class="quick-card-link group block">
          <CodeWindow filename={s.filename} icon={s.icon} lineNumbers={false} wrap={true} class="h-full text-sm">
            <div><span class="text-accent-light">&gt; {s.command}</span></div>
            <div class="text-white/40 mt-2">{s.tagline} →</div>
          </CodeWindow>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, rgba(129, 140, 248, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(129, 140, 248, 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 40%, transparent 90%);
  }

  .warm-heading {
    color: #fdf1e3;
    text-shadow: 0 0 30px rgba(251, 191, 36, 0.25), 0 0 60px rgba(251, 146, 60, 0.15);
  }

  .quick-card-link {
    display: block;
    transition: transform 0.2s ease;
  }

  .quick-card-link:hover {
    transform: translateY(-3px);
  }
</style>

// Neon gradient fill + glowing border per card.
const styleB = [
  { bg: 'linear-gradient(135deg, #3b5fe0, #6d3be0)', border: 'rgba(120,150,255,0.7)', glow: 'rgba(90,110,255,0.35)', icon: '#ffffff', label: '#d6ddff', title: '#ffffff', subtitle: '#dbe0ff' },
  { bg: 'linear-gradient(135deg, #e0673b, #e0a63b)', border: 'rgba(255,170,110,0.7)', glow: 'rgba(255,140,60,0.3)', icon: '#ffffff', label: '#ffe6d3', title: '#fff6ea', subtitle: '#ffe6d3' },
  { bg: 'linear-gradient(135deg, #1fae82, #3be0b0)', border: 'rgba(100,255,210,0.7)', glow: 'rgba(60,255,190,0.3)', icon: '#ffffff', label: '#d3ffef', title: '#f0fff9', subtitle: '#d3ffef' },
];
---

<section id="home" class="hero relative px-6 sm:px-10 pt-10 sm:pt-12 pb-16 overflow-hidden">
  <div class="relative max-w-5xl w-full mx-auto flex flex-col sm:flex-row sm:items-center gap-14 sm:gap-16">
    <div class="text-center sm:text-left sm:flex-shrink-0">
      <p class="kicker justify-center sm:justify-start flex">AI/ML &middot; Data &middot; Software</p>
      <h1 class="warm-heading font-display text-6xl sm:text-7xl font-semibold leading-[1.05] mt-4">
        Hey, I'm Sakthi.
      </h1>

      <p class="mt-5 text-lg text-white/60 leading-relaxed max-w-md mx-auto sm:mx-0">
        Computer Science student exploring AI, machine learning, and data through hands-on projects and software
        development. Currently seeking internship opportunities across AI/ML, Data, and Software.
      </p>

      <div class="mt-8 flex items-center gap-5 justify-center sm:justify-start">
        {socials.map((social) => (
          <a
            href={social.href}
            aria-label={social.label}
            class="text-white/50 hover:text-white transition-colors"
          >
            <svg viewBox="0 0 24 24" width="38" height="38" fill="currentColor">
              <path d={social.icon} />
            </svg>
          </a>
        ))}
        <a href="/resume.pdf" class="btn-ghost">View resume</a>
      </div>
    </div>

    <div class="relative mx-auto sm:mx-0" style="width: min(100%, 460px); aspect-ratio: 380 / 300;">
      {cards.map((c, i) => (
        <a
          href={c.href}
          aria-label={c.title}
          class="fan-card block overflow-hidden p-4"
          style={`width: 44%; background: ${styleB[i].bg}; border: 1.5px solid ${styleB[i].border}; box-shadow: 0 0 30px ${styleB[i].glow}, 0 14px 26px rgba(0,0,0,0.4); top: ${c.pos.top}; left: ${c.pos.left}; --rot: ${c.pos.rot}; --z: ${c.pos.z};`}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={styleB[i].icon} stroke-width="1.7" set:html={c.icon} />
          <p class="mt-2 text-[10px] font-semibold uppercase tracking-wide" style={`color: ${styleB[i].label};`}>{c.label}</p>
          <p class="mt-1 font-display font-bold text-[13.5px] leading-tight" style={`color: ${styleB[i].title};`}>{c.title}</p>
          <p class="mt-1 text-[10.5px] leading-snug" style={`color: ${styleB[i].subtitle};`}>{c.subtitle}</p>
          <p class="card-link mt-2.5 text-[11px] font-semibold" style={`color: ${styleB[i].label};`}>
            {c.linkText} <span class="card-link-arrow">&rarr;</span>
          </p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .btn-primary {
    font-size: 14px;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: 8px;
    background: #f2ede6;
    color: #0a0a0a;
    transition: opacity 0.18s ease;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-ghost {
    font-size: 14px;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #f2ede6;
    transition: border-color 0.18s ease;
  }

  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.45);
  }

  .fan-card {
    position: absolute;
    aspect-ratio: 4 / 3.6;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
    transform: rotate(var(--rot));
    z-index: var(--z);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .fan-card:hover {
    transform: rotate(var(--rot)) translateY(-10px);
    z-index: 10;
  }

  .card-link {
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.18s ease;
  }

  .card-link-arrow {
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .fan-card:hover .card-link,
  .fan-card:focus-visible .card-link {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .fan-card:hover .card-link-arrow,
  .fan-card:focus-visible .card-link-arrow {
    transform: translateX(3px);
  }

  .fan-card:active .card-link-arrow {
    transform: translateX(5px);
  }
</style>

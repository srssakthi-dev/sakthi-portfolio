---
import MobileMenu from './MobileMenu';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-charcoal-950/80 backdrop-blur-md border-b border-charcoal-800">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-lg font-semibold tracking-tight">Sakthi</a>

    <ul class="hidden md:flex items-center gap-8 text-sm text-white/80">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="hover:text-accent transition-colors">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <MobileMenu links={navLinks} client:load />
  </nav>
</header>
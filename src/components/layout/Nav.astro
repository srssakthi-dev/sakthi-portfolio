---
const links = [
  { label: 'About', href: '/about' },
  { label: 'Experience', href: '/experience' },
  { label: 'Projects', href: '/projects' },
  { label: 'Skills', href: '/skills' },
  { label: 'Contact', href: '/contact' },
  { label: 'Resume', href: '/resume.pdf' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 px-6 py-4">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3">
    <a href="/" class="text-lg font-semibold tracking-tight text-white/80 hover:text-white transition-colors">
      Sakthi
    </a>

    <nav class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-white/50">
      {links.map((link) => (
        <a href={link.href} class="hover:text-accent-light transition-colors">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

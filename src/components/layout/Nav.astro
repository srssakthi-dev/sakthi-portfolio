---
const links = [
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Skills', href: '/skills' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="fixed top-0 inset-x-0 z-50 px-6 sm:px-10 py-4 bg-charcoal-950/85 backdrop-blur-md border-b border-ink/[0.06]">
  <div class="max-w-5xl lg:max-w-7xl mx-auto flex items-center justify-between gap-3">
    <a href="/" class="logo-link flex items-center" aria-label="Sakthi — home">
      <img src="/logo.png" alt="" width="47" height="40" class="h-8 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-x-8 text-sm text-ink/50">
      {links.map((link) => (
        <a href={link.href} class="hover:text-accent-light transition-colors">
          {link.label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="md:hidden relative w-9 h-9 flex items-center justify-center text-ink/70 hover:text-ink transition-colors"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <svg id="nav-icon-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="nav-icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="hidden">
        <line x1="5" y1="5" x2="19" y2="19" />
        <line x1="19" y1="5" x2="5" y2="19" />
      </svg>
    </button>
  </div>

  <nav
    id="nav-mobile"
    class="md:hidden hidden mt-3 mx-4 rounded-xl border border-ink/10 bg-charcoal-900/95 backdrop-blur-sm overflow-hidden"
  >
    {links.map((link) => (
      <a
        href={link.href}
        class="block px-5 py-3 text-sm text-ink/70 border-b border-ink/5 last:border-b-0 hover:text-accent-light hover:bg-ink/[0.03] transition-colors"
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  /* Hover lift + a little tilt, a quick squish on press/tap, and a
     one-shot "pop" spin triggered by JS on click (below) — covers both
     a lingering hover on desktop and a tap on mobile ("touched"). */
  .logo-link {
    display: inline-flex;
    transition: transform 0.2s ease;
  }

  .logo-link:hover {
    transform: scale(1.08) rotate(-4deg);
  }

  .logo-link:active {
    transform: scale(0.9);
  }

  .logo-link.is-popping img {
    animation: logo-pop 0.5s ease;
  }

  @keyframes logo-pop {
    0% { transform: scale(1) rotate(0deg); }
    40% { transform: scale(1.25) rotate(14deg); }
    70% { transform: scale(0.95) rotate(-6deg); }
    100% { transform: scale(1) rotate(0deg); }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !menu || !iconOpen || !iconClose) return;
    menu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    setOpen(!isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  const logoLink = document.querySelector<HTMLAnchorElement>('.logo-link');
  logoLink?.addEventListener('click', () => {
    logoLink.classList.remove('is-popping');
    // Force a reflow so the animation restarts on repeated clicks.
    void logoLink.offsetWidth;
    logoLink.classList.add('is-popping');
  });
</script>

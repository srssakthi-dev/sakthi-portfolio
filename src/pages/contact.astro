---
import Layout from '../layouts/Layout.astro';

const channels = [
  {
    label: 'Email',
    value: 'srssakthi7@gmail.com',
    href: 'mailto:srssakthi7@gmail.com',
    icon: '<path d="M3 6l9 6 9-6M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/>',
  },
  {
    label: 'GitHub',
    value: 'srssakthi-dev',
    href: 'https://github.com/srssakthi-dev',
    icon: 'M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.19 1.78 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.05 11.05 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.07.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z',
    filled: true,
  },
  {
    label: 'LinkedIn',
    value: 'in/your-profile',
    href: 'https://linkedin.com/in/your-profile',
    icon: 'M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z',
    filled: true,
  },
];
---

<Layout title="Contact">
  <main class="relative px-6 sm:px-10 pt-8 sm:pt-10 pb-24">
    <div class="relative max-w-5xl mx-auto">
      <span class="kicker">Contact</span>
      <h1 class="page-heading mt-3">Let's talk</h1>

      <p class="mt-6 lead max-w-2xl">
        I'm currently open to internship opportunities in AI/ML, data, and software engineering.
        Feel free to reach out, whether it's about a role, a project, or just to say hi.
      </p>

      <div class="mt-8 space-y-4 max-w-md">
        {channels.map((c) => (
          <a
            href={c.href}
            class="flex items-center gap-4 rounded-lg border border-white/10 px-5 py-4 hover:border-accent-light transition-colors group"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill={c.filled ? 'currentColor' : 'none'} stroke={c.filled ? 'none' : 'currentColor'} stroke-width="1.7" class="text-white/50 group-hover:text-accent-light transition-colors flex-shrink-0" set:html={c.icon} />
            <div>
              <p class="meta-text">{c.label}</p>
              <p class="mt-0.5 text-sm text-white/85">{c.value}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/resume.pdf"
          class="px-5 py-2.5 rounded-lg bg-accent text-charcoal-950 text-sm font-semibold hover:bg-accent-light transition-colors"
        >
          View resume
        </a>
        <a
          href="/about"
          class="px-5 py-2.5 rounded-lg border border-white/15 text-white/70 text-sm font-medium hover:border-accent-light hover:text-accent-light transition-colors"
        >
          More about me
        </a>
      </div>
    </div>
  </main>
</Layout>

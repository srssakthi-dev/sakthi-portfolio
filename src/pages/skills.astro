---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';

// Each group gets a color from the site's blue/teal accent family
// (alternating, since there are more groups than hues) — purely
// decorative section-coding, not meaningful categorization.
// tagBg/tagFg feed the shared .tag-highlight component's
// --tag-bg/--tag-fg overrides in global.css.
const groups = [
  {
    label: 'Programming Languages',
    skills: ['Python', 'SQL', 'JavaScript', 'TypeScript', 'C++'],
    tagBg: 'var(--color-accent)',
    tagFg: 'var(--color-accent-dark)',
  },
  {
    label: 'Software & Web Development',
    skills: [
      'REST APIs', 'Node.js', 'Express.js', 'EJS', 'Object-Oriented Programming',
      'React Native', 'Expo', 'HTML', 'CSS', 'p5.js',
    ],
    tagBg: 'var(--color-teal)',
    tagFg: 'var(--color-teal-dark)',
  },
  {
    label: 'AI, Machine Learning & Data Science',
    skills: [
      'PyTorch', 'TensorFlow', 'Scikit-learn', 'LangChain', 'RAG', 'ChromaDB',
      'Pandas', 'NumPy', 'Ollama', 'Whisper', 'Azure AI Foundry', 'Matplotlib', 'Seaborn', 'NLTK',
    ],
    tagBg: 'var(--color-accent)',
    tagFg: 'var(--color-accent-dark)',
  },
  {
    label: 'Databases',
    skills: ['MySQL', 'SQLite'],
    tagBg: 'var(--color-teal)',
    tagFg: 'var(--color-teal-dark)',
  },
  {
    label: 'Tools & Platforms',
    skills: ['Git', 'GitLab (Basic)', 'Jupyter Notebook', 'Google Colab'],
    tagBg: 'var(--color-accent)',
    tagFg: 'var(--color-accent-dark)',
  },
  {
    label: 'Certifications',
    skills: ['AWS Cloud Foundations'],
    tagBg: 'var(--color-teal)',
    tagFg: 'var(--color-teal-dark)',
  },
];
---

<Layout title="Skills">
  <main class="relative px-6 sm:px-10 pt-8 sm:pt-10 pb-24">
    <div class="relative max-w-5xl mx-auto">
      <h1 class="page-heading">Skills</h1>

      <div class="mt-8 space-y-8">
        {groups.map((group) => (
          <div>
            <h2 class="kicker">{group.label}</h2>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="tag-highlight" style={`--tag-bg: ${group.tagBg}; --tag-fg: ${group.tagFg};`}>
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/projects" variant="primary">See it in action</Button>
        <Button href="/contact" variant="secondary">Get in touch</Button>
      </div>
    </div>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

const categories = ['All', ...new Set(projects.map((p) => p.category))];
---

<Layout title="Projects">
  <main class="relative px-6 sm:px-10 pt-8 sm:pt-10 pb-24">
    <div class="relative max-w-5xl mx-auto">
      <span class="kicker">Projects</span>
      <h1 class="page-heading mt-3">Some things I've built</h1>

      <div class="mt-6 flex flex-wrap gap-2" id="filter-bar">
        {categories.map((cat) => (
          <button
            type="button"
            class="filter-pill"
            data-filter={cat}
            aria-pressed={cat === 'All' ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <p class="mt-4 meta-text" id="filter-empty" hidden>No projects in this category yet.</p>

      <div class="mt-8 space-y-10 sm:space-y-12" id="project-grid">
        {projects.map((project) => {
          const primaryHref = project.notebookUrl || project.repoUrl;
          const primaryLabel = project.notebookUrl ? 'View notebook' : 'View on GitHub';
          return (
            <div id={project.slug} class="grid grid-cols-1 sm:grid-cols-[320px_1fr] gap-6 sm:gap-10 items-start scroll-mt-24" data-category={project.category}>
              <a href={primaryHref} class="block rounded-lg overflow-hidden bg-charcoal-800 aspect-[4/3]">
                {project.image ? (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover"
                    style={project.fit === 'contain' ? 'object-fit: contain; background: #0a0a0a;' : ''}
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center gap-2 text-white/25">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={project.thumbIcon} />
                  </div>
                )}
              </a>

              <div>
                <p class="meta-text">{project.category} &middot; {project.period}</p>
                <a href={primaryHref} class="mt-2 block font-display font-semibold text-lg text-white/90 hover:text-white transition-colors">
                  {project.title}
                </a>
                <p class="mt-2 text-sm body-text max-w-xl">{project.summary}</p>

                {project.pipeline && (
                  <div class="mt-3 pipeline-chain">
                    {project.pipeline.map((step, i) => (
                      <Fragment>
                        {i > 0 && <span class="pipeline-arrow" aria-hidden="true">&rsaquo;</span>}
                        <span class={`pipeline-step${i === project.pipeline!.length - 1 ? ' pipeline-step--final' : ''}`}>
                          {step}
                        </span>
                      </Fragment>
                    ))}
                  </div>
                )}
                {project.modelComparison && (
                  <div class="mt-3 flex flex-col gap-2.5 max-w-xs">
                    {project.modelComparison.map((m) => (
                      <div class="model-row">
                        <div class="model-row-label">
                          <span>{m.name.toLowerCase().replace(/\s+/g, '_')}</span>
                          <span class="model-row-value">{(m.accuracy * 100).toFixed(1)}%</span>
                        </div>
                        <div class="model-bar-track">
                          <div class="model-bar-fill" style={`--target-width: ${(m.accuracy * 100).toFixed(1)}%`}></div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tech.map((t) => (
                    <span class="text-xs px-3.5 py-1.5 rounded-full border border-white/15 text-white/65">{t}</span>
                  ))}
                </div>

                <div class="mt-4 flex items-center gap-4">
                  <a href={primaryHref} class="meta-text hover:text-white transition-colors">
                    {primaryLabel} →
                  </a>
                  {project.demoUrl && (
                    <a href={project.demoUrl} class="meta-text hover:text-white transition-colors">
                      ▶ Demo
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="https://github.com/srssakthi-dev"
          class="px-5 py-2.5 rounded-lg border border-white/15 text-white/70 text-sm font-medium hover:border-white/35 hover:text-white transition-colors"
        >
          See more on GitHub →
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  const bar = document.getElementById('filter-bar');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid > [data-category]');
  const empty = document.getElementById('filter-empty');

  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-pill');
    if (!btn) return;

    bar.querySelectorAll('.filter-pill').forEach((b) => b.setAttribute('aria-pressed', 'false'));
    btn.setAttribute('aria-pressed', 'true');

    const filter = btn.dataset.filter;
    let visibleCount = 0;

    cards.forEach((card) => {
      const show = filter === 'All' || card.dataset.category === filter;
      card.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    if (empty) empty.hidden = visibleCount !== 0;
  });

  // Reveal model-comparison bars with a one-time fill animation as each
  // project card scrolls into view — mirrors the site's other tab-fade-in
  // treatment (one-shot, not ambient/looping) and respects reduced motion.
  const bars = document.querySelectorAll<HTMLElement>('.model-bar-fill');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion || !('IntersectionObserver' in window)) {
    bars.forEach((bar) => bar.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    bars.forEach((bar) => observer.observe(bar));
  }
</script>

<style>
  .filter-pill {
    font-size: 12.5px;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.55);
    background: transparent;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }

  .filter-pill:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: rgba(255, 255, 255, 0.9);
  }

  .filter-pill[aria-pressed='true'] {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  /* Pipeline step chain — replaces the old "A → B → C" text line with
     bordered steps and an accent chevron, final step highlighted. */
  .pipeline-chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
  }

  .pipeline-step {
    font-size: 11px;
    padding: 7px 12px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .pipeline-step:hover {
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .pipeline-step--final {
    border-color: var(--color-accent);
    color: var(--color-accent-light);
  }

  .pipeline-arrow {
    color: var(--color-accent);
    font-size: 13px;
  }

  /* Model comparison bars — replaces the old plain-text accuracy line.
     Bar fills to its real accuracy value once scrolled into view. */
  .model-row-label {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 5px;
  }

  .model-row-value {
    color: var(--color-accent-light);
  }

  .model-bar-track {
    height: 5px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .model-bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-accent-dark), var(--color-accent));
    border-radius: 3px;
    transition: width 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .model-bar-fill.is-visible {
    width: var(--target-width);
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Pill from '../components/ui/Pill.astro';
import { projects } from '../data/projects';

// Fixed tab order (AI/ML leads since it's the bulk of the work), rather
// than relying on whatever order categories first appear in the data.
const CATEGORY_ORDER = ['All', 'AI / ML', 'Software Engineering', 'Creative'];
const presentCategories = new Set(projects.map((p) => p.category));
const categories = CATEGORY_ORDER.filter((cat) => cat === 'All' || presentCategories.has(cat as any));
---

<Layout title="Projects">
  <main class="relative px-6 sm:px-10 pt-8 sm:pt-10 pb-24">
    <div class="relative max-w-5xl lg:max-w-6xl mx-auto">
      <h1 class="page-heading">Projects</h1>

      <div class="mt-6 flex flex-wrap gap-2" id="filter-bar">
        {categories.map((cat) => (
          <Pill
            as="button"
            variant="filter"
            type="button"
            class="filter-pill text-[12.5px] px-3.5 py-1.5"
            data-filter={cat}
            aria-pressed={cat === 'All' ? 'true' : 'false'}
          >
            {cat}
          </Pill>
        ))}
      </div>

      <p class="mt-4 meta-text" id="filter-empty" hidden>No projects in this category yet.</p>

      <div class="mt-8 space-y-10 sm:space-y-12 lg:space-y-0 lg:grid lg:grid-cols-3 lg:gap-x-8 lg:gap-y-12 lg:items-start" id="project-grid">
        {projects.map((project) => {
          const primaryHref = project.notebookUrl || project.repoUrl;
          const primaryLabel = project.notebookUrl ? 'View notebook' : 'View on GitHub';
          return (
            <div id={project.slug} class="grid grid-cols-1 sm:grid-cols-[320px_minmax(0,1fr)] lg:grid-cols-1 gap-6 sm:gap-10 lg:gap-4 items-start scroll-mt-24" data-category={project.category}>
              <a href={primaryHref} class="image-frame block rounded-lg overflow-hidden bg-charcoal-800 aspect-[4/3]">
                {project.image ? (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover"
                    style={project.fit === 'contain' ? 'object-fit: contain; background: var(--color-charcoal-800);' : ''}
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center gap-2 text-ink/25">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={project.thumbIcon} />
                  </div>
                )}
              </a>

              <div class="surface-card p-4 sm:p-5 min-w-0">
                <p class="meta-text">{project.category} &middot; {project.period}</p>
                <a href={primaryHref} class="mt-2 block font-display font-semibold text-lg text-ink/90 hover:text-accent-light transition-colors">
                  {project.title}
                </a>
                <p class="mt-2 text-sm body-text max-w-xl">{project.summary}</p>

                {project.pipeline && (
                  <div class="mt-3 pipeline-chain">
                    {project.pipeline.map((step, i) => (
                      <Fragment>
                        {i > 0 && <span class="pipeline-arrow" aria-hidden="true">&rsaquo;</span>}
                        <span class={`pipeline-step${i === project.pipeline!.length - 1 ? ' pipeline-step--final' : ''}`}>
                          {step}
                        </span>
                      </Fragment>
                    ))}
                  </div>
                )}
                {project.modelComparison && (
                  <div class="mt-3 flex flex-col gap-2.5 max-w-xs">
                    {project.modelComparison.map((m) => (
                      <div class="model-row">
                        <div class="model-row-label">
                          <span>{m.name.toLowerCase().replace(/\s+/g, '_')}</span>
                          <span class="model-row-value">{(m.accuracy * 100).toFixed(1)}%</span>
                        </div>
                        <div class="model-bar-track">
                          <div class="model-bar-fill" style={`--target-width: ${(m.accuracy * 100).toFixed(1)}%`}></div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tech.map((t) => (
                    <span class="tag-highlight">{t}</span>
                  ))}
                </div>

                <div class="mt-3">
                  <a href={primaryHref} class="project-link">{primaryLabel} &rarr;</a>
                </div>

                {project.demoUrl && (
                  <div class="mt-2">
                    <a href={project.demoUrl} class="project-link">&#9654; Demo</a>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="https://github.com/srssakthi-dev" variant="secondary">See more on GitHub →</Button>
      </div>
    </div>
  </main>
</Layout>

<script>
  const bar = document.getElementById('filter-bar');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid > [data-category]');
  const empty = document.getElementById('filter-empty');

  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-pill');
    if (!btn) return;

    bar.querySelectorAll('.filter-pill').forEach((b) => b.setAttribute('aria-pressed', 'false'));
    btn.setAttribute('aria-pressed', 'true');

    const filter = btn.dataset.filter;
    let visibleCount = 0;

    cards.forEach((card) => {
      const show = filter === 'All' || card.dataset.category === filter;
      card.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    if (empty) empty.hidden = visibleCount !== 0;
  });

  // Reveal model-comparison bars with a one-time fill animation as each
  // project card scrolls into view — mirrors the site's other tab-fade-in
  // treatment (one-shot, not ambient/looping) and respects reduced motion.
  const bars = document.querySelectorAll<HTMLElement>('.model-bar-fill');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion || !('IntersectionObserver' in window)) {
    bars.forEach((bar) => bar.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );
    bars.forEach((bar) => observer.observe(bar));
  }
</script>

<style>
  /* .tag-highlight moved to global.css so the Skills page can share it
     too — it's no longer page-scoped here. */

  /* The card's own repo/notebook/demo links — underlined accent text,
     sitting below the tech tags now instead of up next to the date. */
  .project-link {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-accent-dark);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent-dark) 35%, transparent);
    text-underline-offset: 3px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .project-link:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  /* .filter-pill itself now carries no visual rules — its look comes
     entirely from the shared <Pill> component's .pill class in
     global.css. It's kept purely as a hook for the filter script below
     to query, so the two stay decoupled from styling. */

  /* Pipeline step chain — replaces the old "A → B → C" text line with
     bordered steps and an accent chevron, final step highlighted. */
  .pipeline-chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
  }

  .pipeline-step {
    font-size: 11px;
    padding: 7px 12px;
    border-radius: 6px;
    border: 1px solid rgba(72, 64, 55, 0.16);
    color: rgba(58, 53, 48, 0.75);
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .pipeline-step:hover {
    border-color: rgba(72, 64, 55, 0.35);
    color: var(--color-ink);
  }

  .pipeline-step--final {
    border-color: var(--color-accent);
    color: var(--color-accent-light);
  }

  .pipeline-arrow {
    color: var(--color-accent);
    font-size: 13px;
  }

  /* Model comparison bars — replaces the old plain-text accuracy line.
     Bar fills to its real accuracy value once scrolled into view. */
  .model-row-label {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(58, 53, 48, 0.6);
    margin-bottom: 5px;
  }

  .model-row-value {
    color: var(--color-accent-light);
  }

  .model-bar-track {
    height: 5px;
    border-radius: 3px;
    background: rgba(72, 64, 55, 0.1);
    overflow: hidden;
  }

  .model-bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-accent-dark), var(--color-accent));
    border-radius: 3px;
    transition: width 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .model-bar-fill.is-visible {
    width: var(--target-width);
  }
</style>
